<idea-plugin>
    <id>org.babelserver.intellijnostos</id>
    <name>Nostos</name>
    <vendor url="https://github.com/hallyhaa/intellij-nostos">Hallvard Ystad</vendor>

    <description><![CDATA[
    Language support for <a href="https://heynostos.tech">Nostos</a>,
    a functional-first programming language with lightweight concurrency,
    pattern matching, and non-blocking I/O.
    ]]></description>

    <change-notes><![CDATA[
    <b>0.2.2</b>
    <ul>
        <li>"Add missing import" quick-fix on unknown function/variable errors</li>
        <li>Highlight usages of the symbol under the caret (Ctrl+Shift+F7)</li>
        <li>Go to Symbol across the project (Ctrl+Alt+Shift+N)</li>
        <li>"N references" CodeVision hint above function and type definitions</li>
        <li>Call Hierarchy (Ctrl+Alt+H)</li>
    </ul>
    <b>0.2.1</b>
    <ul>
        <li>Inlay type hints</li>
        <li>Hover documentation popup (Ctrl+Q)</li>
        <li>Parameter info (signature help) when calling functions</li>
        <li>New Project wizard for scaffolding Nostos projects</li>
        <li>New Nostos File action</li>
        <li>Run <code>[[bin]]</code> entry points declared in nostos.toml</li>
        <li>Live reload when .nos files change on disk</li>
        <li>Progress reporting for long-running language server work</li>
        <li>Friendlier parser error messages</li>
    </ul>
    <b>0.2.0</b>
    <ul>
        <li>File status indicators in project tree for files with compile errors</li>
        <li>Run configurations for executing Nostos programs</li>
    </ul>
    <b>0.1.0</b>
    <ul>
        <li>Initial release</li>
        <li>Syntax highlighting</li>
        <li>Parser with full language grammar support</li>
        <li>Code completion for keywords</li>
        <li>Go to Definition and Find Usages</li>
        <li>Code formatting and indentation</li>
        <li>Structure view</li>
        <li>Code folding</li>
        <li>Brace matching</li>
        <li>Line and block commenting</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosFileType"
            fieldName="INSTANCE"
            language="Nostos"
            extensions="nos"/>
        <lang.parserDefinition
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosSyntaxHighlighterFactory"/>
        <lang.commenter
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosCommenter"/>
        <lang.braceMatcher
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosBraceMatcher"/>
        <lang.foldingBuilder
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosFoldingBuilder"/>
        <lang.psiStructureViewFactory
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosStructureViewFactory"/>
        <lang.findUsagesProvider
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosFindUsagesProvider"/>
        <lang.documentationProvider
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosLspDocumentationProvider"/>
        <codeInsight.parameterInfo
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosLspParameterInfoHandler"/>
        <renameHandler implementation="org.babelserver.intellijnostos.lsp.NostosLspRenameHandler"/>
        <completion.contributor
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosCompletionContributor"/>
        <completion.contributor
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosLspCompletionContributor"
            order="last"/>
        <lang.formatter
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosFormattingModelBuilder"/>
        <!--suppress PluginXmlI18n -->
        <projectConfigurable
            parentId="language"
            instance="org.babelserver.intellijnostos.settings.NostosSettingsConfigurable"
            id="nostos.settings"
            displayName="Nostos"/>
        <configurationType
            implementation="org.babelserver.intellijnostos.run.NostosConfigurationType"/>
        <runConfigurationProducer
            implementation="org.babelserver.intellijnostos.run.NostosRunConfigurationProducer"/>
        <runLineMarkerContributor
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.run.NostosRunLineMarkerContributor"/>
        <externalAnnotator
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosExternalAnnotator"/>
        <externalAnnotator
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosSemanticHighlighter"/>
        <highlightUsagesHandlerFactory
            implementation="org.babelserver.intellijnostos.lsp.NostosHighlightUsagesHandlerFactory"/>
        <gotoSymbolContributor
            implementation="org.babelserver.intellijnostos.lsp.NostosWorkspaceSymbolContributor"/>
        <codeInsight.daemonBoundCodeVisionProvider
            implementation="org.babelserver.intellijnostos.lsp.NostosReferencesCodeVisionProvider"/>
        <callHierarchyProvider
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.lsp.NostosCallHierarchyProvider"/>
        <codeInsight.declarativeInlayProvider
            language="Nostos"
            implementationClass="org.babelserver.intellijnostos.NostosInlayHintsProvider"
            isEnabledByDefault="true"
            group="TYPES_GROUP"
            providerId="nostos.type.hints"
            bundle="messages.NostosBundle"
            nameKey="inlay.nostos.types.name"
            descriptionKey="inlay.nostos.types.description"/>
        <!--suppress PluginXmlI18n -->
        <notificationGroup id="Nostos" displayType="BALLOON"/>
        <postStartupActivity
            implementation="org.babelserver.intellijnostos.lsp.NostosLspStartupActivity"/>
        <newProjectWizard.generator
            implementation="org.babelserver.intellijnostos.wizard.NostosNewProjectWizard"/>
        <projectViewNodeDecorator
            implementation="org.babelserver.intellijnostos.lsp.NostosFileStatusDecorator"/>
        <internalFileTemplate name="Nostos File"/>
    </extensions>

    <actions>
        <!--suppress PluginXmlI18n -->
        <action
            id="Nostos.NewNostosFile"
            class="org.babelserver.intellijnostos.NostosCreateFileAction"
            text="Nostos File"
            description="Create a new Nostos file"
            icon="/icons/nostos.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
    </actions>
</idea-plugin>
